    {
        "id": "mqtt_in_ultra",
        "type": "mqtt in",
        "z": "e5ff2c60f76d8eb0",
        "name": "Nhận Json DHT22",
        "topic": "mqtt/temp_humi",
        "qos": "2",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": false,
