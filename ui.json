    {
        "id": "func_main_ultra",
        "type": "function",
        "z": "e5ff2c60f76d8eb0",
        "name": "Xử lý Logic Ultra",
        "func": "let stats = context.get('stats_ultra') || {\n    sumT: 0,\n    sumH: 0,\n    count: 0,\n    startTime: Date.now()\n};\n\nlet data = msg.payload;\n\n// Nếu payload là string thì parse JSON\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (e) {\n        node.error(\"JSON lỗi\");\n        return null;\n    }\n}\n\n// Nếu không có dữ liệu thì bỏ qua\nif (!data) {\n    return null;\n}\n\nlet t = Number(data.temperature) || 0;\nlet h = Number(data.humidity) || 0;\n\nlet led = (data.led || \"off\").toUpperCase();\nlet relay = (data.relay || \"off\").toUpperCase();\n\nstats.count++;\nstats.sumT += t;\nstats.sumH += h;\n\ncontext.set('stats_ultra', stats);\n\nlet avgT = (stats.sumT / stats.count).toFixed(1);\nlet avgH = (stats.sumH / stats.count).toFixed(1);\n\nlet uptimeSec = Math.floor((Date.now() - stats.startTime) / 1000);\n\nlet days = Math.floor(uptimeSec / 86400);\nlet hours = Math.floor((uptimeSec % 86400) / 3600);\nlet mins = Math.floor((uptimeSec % 3600) / 60);\n\nlet uptimeStr = `${days} ngày ${hours} giờ ${mins} phút`;\n\n// ===== CẢNH BÁO =====\nlet alerts = [];\nlet notifications = [];\n\nif (t > 40) {\n    alerts.push(\"🔥 Nhiệt độ cao\");\n    notifications.push(\"Nhiệt độ vượt mức!\");\n}\n\nif (h > 85) {\n    alerts.push(\"💧 Độ ẩm cao\");\n    notifications.push(\"Độ ẩm vượt mức!\");\n}\n\nlet alertStatus =\n    alerts.length > 0\n    ? alerts.join(\" & \")\n    : \"✅ Hoạt động tốt\";\n\nlet notificationText = null;\n\nif (notifications.length > 0) {\n    notificationText =\n        \"Cảnh báo: \" + notifications.join(\" và \");\n}\n\nreturn [\n    { payload: t },                          // 1\n    { payload: h },                          // 2\n    { payload: t, topic: \"Nhiệt độ\" },       // 3\n    { payload: h, topic: \"Độ ẩm\" },          // 4\n    { payload: alertStatus },                // 5\n    { payload: avgT },                       // 6\n    { payload: avgH },                       // 7\n    { payload: stats.count + \" bản ghi\" },  // 8\n    { payload: uptimeStr },                  // 9\n    notificationText ? { payload: notificationText } : null, //10\n    { payload: led },                        //11\n    { payload: relay }                       //12\n];",
        "outputs": 12,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 200,
