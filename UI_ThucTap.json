    {
        "id": "mqtt_in_ultra",
        "type": "mqtt in",
        "z": "e5ff2c60f76d8eb0",
        "name": "Nhận Json DHT22",
        "topic": "mqtt/temp_humi",
        "qos": "2",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 150,
        "y": 200,
        "wires": [
            [
                "func_main_ultra"
            ]
        ]
    },
    {
        "id": "func_main_ultra",
        "type": "function",
        "z": "e5ff2c60f76d8eb0",
        "name": "Xử lý Logic Ultra",
        "func": "let stats = context.get('stats_ultra') || { sumT: 0, sumH: 0, count: 0, startTime: Date.now() };\n\nlet data = msg.payload;\nif (typeof data === \"string\") {\n    try { data = JSON.parse(data); } catch(e) { data = null; }\n}\n\nif (data) {\n    let t = Number(data.temperature) || 0;\n    let h = Number(data.humidity) || 0;\n    \n    stats.count++;\n    stats.sumT += t;\n    stats.sumH += h;\n    context.set('stats_ultra', stats);\n\n    let avgT = (stats.sumT / stats.count).toFixed(1);\n    let avgH = (stats.sumH / stats.count).toFixed(1);\n    \n    let uptimeSec = Math.floor((Date.now() - stats.startTime) / 1000);\n    let days = Math.floor(uptimeSec / 86400);\n    let hours = Math.floor((uptimeSec % 86400) / 3600);\n    let mins = Math.floor((uptimeSec % 3600) / 60);\n    let uptimeStr = `${days} ngày ${hours} giờ ${mins} phút`;\n\n    // --- LOGIC CẢNH BÁO ---\n    let alerts = [];\n    let notifications = [];\n\n    // Kiểm tra nhiệt độ \n    if (t > 40) {\n        alerts.push(\"🔥 Nhiệt độ cao\");\n        notifications.push(\"Nhiệt độ vượt mức!\");\n    }\n    \n    // Kiểm tra độ ẩm \n    if (h > 85) {\n        alerts.push(\"💧 Độ ẩm cao\");\n        notifications.push(\"Độ ẩm vượt mức!\");\n    }\n\n    // Tổng hợp kết quả\n    let alertStatus = alerts.length > 0 ? alerts.join(\" & \") : \"✅ Hoạt động tốt\";\n    \n    // TRẢ LẠI THÀNH TEXT BÌNH THƯỜNG:\n    let notificationText = null;\n    if (notifications.length > 0) {\n        notificationText = \"Cảnh báo: \" + notifications.join(\" và \");\n    }\n\n    return [\n        { payload: t },                                 // 1. Gauge Temp\n        { payload: h },                                 // 2. Gauge Hum\n        { payload: t, topic: \"Nhiệt độ\" },             // 3. Chart Temp\n        { payload: h, topic: \"Độ ẩm\" },                // 4. Chart Hum\n        { payload: alertStatus },                        // 5. Alert text\n        { payload: avgT },                              // 6. Avg Temp\n        { payload: avgH },                              // 7. Avg Hum\n        { payload: stats.count + \" bản ghi\" },          // 8. Total records\n        { payload: uptimeStr },                         // 9. Uptime\n        notificationText ? { payload: notificationText } : null  // 10. Notification\n    ];\n}",
        "outputs": 10,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
